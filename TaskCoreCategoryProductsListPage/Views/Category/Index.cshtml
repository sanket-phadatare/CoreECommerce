@model IEnumerable<TaskCoreCategoryProductsListPage.Models.Category>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a class="btn btn-info" asp-action="Create" asp-controller="Category">Add New Category</a> 
    <a class="btn btn-success" asp-action="Create" asp-controller="Product">Add New Product</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryName)
            </th>
            <th>Actions</th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @if(Model != null && Model.Count() > 0)
        {
             foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CategoryId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CategoryId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CategoryId">Delete</a>
            </td>
        </tr>
            }
        }

        else
            {
                <tr>
                    <td colspan="3" class="text-center">No categories found</td>
                </tr>
            }
    </tbody>
</table>
