@model IEnumerable<Category>

<div class="d-md-flex flex-md-wrap justify-content-center flex-md-equal w-100 my-md-3 ps-md-3">

    @{
        int count = 1;
        foreach (var item in Model)
        {
            if (count % 2 != 0)
            {
                <a asp-controller="Product" asp-action="ProductListing" class="text-decoration-none" asp-route-id="@item.CategoryId">
                    <div class="bg-dark text-white p-4 rounded me-md-3 mt-1 pt-3 px-3 pt-md-5 px-md-5 text-center overflow-hidden">
                        <div class="my-3 py-3">
                            <h2 class="display-5">@item.CategoryName</h2>
                            <p class="lead">And an even wittier subheading.</p>
                        </div>
                        <div class="bg-body-tertiary shadow-sm mx-auto"
                             style="width: 80%; height: 300px; border-radius: 21px 21px 0 0;"></div>
                    </div>
                </a>
                count++;
            }
            else
            {
                <a asp-controller="Product" asp-action="ProductListing" class="text-decoration-none text-black" asp-route-id="@item.CategoryId">
                    <div class="bg-light text-blck p-4 rounded me-md-3 pt-3 px-3 mt-1 pt-md-5 px-md-5 text-center overflow-hidden">
                    <div class="my-3 p-3">
                        <h2 class="display-5">@item.CategoryName</h2>
                        <p class="lead">And an even wittier subheading.</p>
                    </div>
                    <div class="bg-dark shadow-sm mx-auto" style="width: 80%; height: 300px; border-radius: 21px 21px 0 0;">
                    </div>
                </div>
                </a>
                count++;

            }
        }
    }

</div>